{
  "name": "yapmod-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Yapin with the Yapmod client in a native desktop window",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tauri build",
    "tauri": "tauri",
    "test": "pnpm test:js && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "build:plugin": "node scripts/build-plugin.mjs",
    "typecheck": "tsc --project plugin/tsconfig.json",
    "test:js": "pnpm typecheck && pnpm build:plugin && node --test && node --test .github/scripts/*.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@yapmod/builder": "1.3.0",
    "@yapmod/types": "1.1.0",
    "release-please": "17.11.2",
    "solid-js": "1.9.18",
    "typescript": "7.0.2"
  }
}
