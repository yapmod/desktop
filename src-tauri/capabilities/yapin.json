{
  "identifier": "yapin",
  "description": "Desktop integration for the Yapin application.",
  "local": false,
  "remote": {
    "urls": [
      "https://www.yapin.gg/*",
      "https://yapin.gg/*"
    ]
  },
  "webviews": [
    "yapin"
  ],
  "permissions": [
    "allow-desktop-info",
    "allow-yaplay-start",
    "allow-yaplay-exchange",
    "allow-yaplay-stop",
    "allow-desktop-update",
    "autostart:allow-is-enabled",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "allow-notification-permission",
    "allow-desktop-notify",
    "allow-desktop-close-notification",
    "allow-window-caption",
    "allow-set-integrated-titlebar"
  ]
}
