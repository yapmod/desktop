{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yapmod Desktop",
  "version": "../package.json",
  "identifier": "gg.yapmod.desktop",
  "build": { "frontendDist": "../shell", "additionalWatchFolders": ["../plugin/src", "../plugin/manifest.json", "../scripts/build-plugin.mjs"] },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "SocialNetworking",
    "shortDescription": "Yapin with the Yapmod client",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": { "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-nice"] }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "assets/dmg-background.png",
        "windowSize": { "width": 642, "height": 406 },
        "appPosition": { "x": 173, "y": 213 },
        "applicationFolderPosition": { "x": 479, "y": 213 }
      }
    }
  },
  "plugins": { "updater": { "pubkey": "", "endpoints": [] } }
}
